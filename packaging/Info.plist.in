<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- 1f6s-desktop macOS .app 包描述文件;@VER@ 由打包流程替换为项目版本 -->
<plist version="1.0">
<dict>
  <key>CFBundleExecutable</key><string>1f6s-desktop</string>
  <key>CFBundleIdentifier</key><string>site.1f6s.desktop</string>
  <key>CFBundleName</key><string>1f6s-desktop</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>@VER@</string>
  <key>CFBundleVersion</key><string>@VER@</string>
  <key>CFBundleIconFile</key><string>1f6s-desktop</string>
  <key>LSMinimumSystemVersion</key><string>10.14</string>
  <key>NSHighResolutionCapable</key><true/>
  <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
</dict>
</plist>
