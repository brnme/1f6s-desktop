// 1f6s-desktop Windows 资源脚本模板(经 CMake configure_file 填充 @…@ 占位
// 生成 1f6s-desktop.rc,再交给 rc.exe / windres 编进 exe)。
#include <windows.h>

// rc.exe 默认按 ANSI 代码页解读源文件;声明 UTF-8 以正确保留下方 © 字符。
#pragma code_page(65001)

1 ICON "@CMAKE_CURRENT_SOURCE_DIR@/packaging/icon/1f6s-desktop.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK  0x3fL
#ifdef _DEBUG
 FILEFLAGS      0x1L
#else
 FILEFLAGS      0x0L
#endif
 FILEOS         0x40004L // VOS_NT_WINDOWS32
 FILETYPE       0x1L     // VFT_APP
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // 040904b0 = 美国英语(0409)+ Unicode(04b0 = 1200),与下方 Translation 对应
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription",  "1f6s desktop"
            VALUE "FileVersion",      "@PROJECT_VERSION_MAJOR@.@PROJECT_VERSION_MINOR@.@PROJECT_VERSION_PATCH@.0"
            VALUE "LegalCopyright",   "© 1f6s"
            VALUE "OriginalFilename", "1f6s-desktop.exe"
            VALUE "ProductName",      "1f6s-desktop"
            VALUE "ProductVersion",   "@PROJECT_VERSION_MAJOR@.@PROJECT_VERSION_MINOR@.@PROJECT_VERSION_PATCH@.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
