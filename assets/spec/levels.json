{
  "spec": "1f6s",
  "version": "1.0",
  "description": "1帧6秒 倡议八级压缩规范的机器可读参数表。脚本 1f6s.sh 与 agent playbook 均以此文件为唯一参数真相源,避免三处漂移。",
  "defaults": {
    "level": "L4",
    "output_suffix": "_1f6s.mp4",
    "note": "默认推荐 L4(1帧/6秒 + 480p 黑白 + CRF 34 + stillimage + 20k 音频)。默认输出与源同目录,命名 <basename>_1f6s.mp4,不覆盖原视频。"
  },
  "audio_codec": "aac",
  "audio_channels": 1,
  "pixel_format": "yuv420p",
  "preset": "slow",
  "formula": {
    "twopass_bitrate": "目标体积(MB) × 8192 / 总时长(秒) = 总比特率(kbps);视频码率 = 总比特率 − 音频码率(kbps)",
    "note": "L7 锁死目标体积时使用:第一遍分析(-pass 1 -f mp4 /dev/null 或 NUL),第二遍输出(-pass 2)。"
  },
  "levels": [
    {
      "id": "L1",
      "name": "标准级",
      "interval": "1/6",
      "scale": "-2:480",
      "color": "color",
      "codec": "libx264",
      "crf": 32,
      "audio_bitrate": "20k",
      "audio_rate": 22050,
      "tune": null,
      "extra": null,
      "twopass": false,
      "scene": "客户对画质有基本要求,需要保留彩色画面(如图表配色、UI 界面区分)。",
      "expected_size": "99分钟 ≈ 30~35 MB"
    },
    {
      "id": "L2",
      "name": "黑白级",
      "interval": "1/6",
      "scale": "-2:480",
      "color": "gray",
      "codec": "libx264",
      "crf": 32,
      "audio_bitrate": "20k",
      "audio_rate": 22050,
      "tune": null,
      "extra": null,
      "twopass": false,
      "scene": "画面主要是黑白 PPT、代码、文字,颜色信息对理解内容无帮助。",
      "expected_size": "99分钟 ≈ 24~28 MB"
    },
    {
      "id": "L3",
      "name": "高压缩级",
      "interval": "1/6",
      "scale": "-2:480",
      "color": "gray",
      "codec": "libx264",
      "crf": 34,
      "audio_bitrate": "20k",
      "audio_rate": 22050,
      "tune": null,
      "extra": null,
      "twopass": false,
      "scene": "需要进一步压缩,且客户接受画质有一定颗粒感。",
      "expected_size": "99分钟 ≈ 18~22 MB"
    },
    {
      "id": "L4",
      "name": "智能调优级",
      "interval": "1/6",
      "scale": "-2:480",
      "color": "gray",
      "codec": "libx264",
      "crf": 34,
      "audio_bitrate": "20k",
      "audio_rate": 22050,
      "tune": "stillimage",
      "extra": null,
      "twopass": false,
      "scene": "画面以幻灯片/静态图表为主,需要尽量保留锐度,同时压到最小。★ 默认推荐。",
      "expected_size": "99分钟 ≈ 16~19 MB"
    },
    {
      "id": "L5",
      "name": "音频极限级",
      "interval": "1/6",
      "scale": "-2:480",
      "color": "gray",
      "codec": "libx264",
      "crf": 34,
      "audio_bitrate": "8k",
      "audio_rate": 8000,
      "tune": "stillimage",
      "extra": null,
      "twopass": false,
      "scene": "传输带宽极低(如 2G/3G 网络),只要求能听清讲的是什么。",
      "expected_size": "99分钟 ≈ 14~17 MB"
    },
    {
      "id": "L6",
      "name": "长间隔级",
      "interval": "1/10",
      "scale": "-2:360",
      "color": "gray",
      "codec": "libx264",
      "crf": 36,
      "audio_bitrate": "8k",
      "audio_rate": 8000,
      "tune": "stillimage",
      "extra": null,
      "twopass": false,
      "scene": "极端压缩需求,语速较慢,且客户接受画面跳跃感较强。",
      "expected_size": "99分钟 ≈ 10~12 MB"
    },
    {
      "id": "L7",
      "name": "2-Pass 精确控制级",
      "interval": "1/10",
      "scale": "-2:360",
      "color": "gray",
      "codec": "libx264",
      "crf": null,
      "audio_bitrate": "8k",
      "audio_rate": 8000,
      "tune": "stillimage",
      "extra": null,
      "twopass": true,
      "scene": "客户明确要求文件必须小于 XX MB,需要精确控制输出体积。",
      "expected_size": "按目标锁定(示例:99分钟压至 8MB,视频码率约 3k)",
      "twopass_example_bv": "3k"
    },
    {
      "id": "L8",
      "name": "H.265 极限级",
      "interval": "1/10",
      "scale": "-2:360",
      "color": "gray",
      "codec": "libx265",
      "crf": 38,
      "audio_bitrate": "8k",
      "audio_rate": 8000,
      "tune": null,
      "extra": "keyint=1:min-keyint=1",
      "twopass": false,
      "scene": "客户使用 VLC/PotPlayer 等现代播放器,不依赖系统原生解码。兼容性风险:必须确认客户端播放器支持 H.265。",
      "expected_size": "99分钟 ≈ 6~8 MB"
    }
  ]
}
